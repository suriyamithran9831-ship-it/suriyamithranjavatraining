mport java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner m = new Scanner(System.in);
        int n = m.nextInt();

        for (int j = 1; j <= n; j++) {  
            for (int i = n; i >= 1; i--){  
                System.out.print("*");
            }
            System.out.println();   
        }
       
    }
}
