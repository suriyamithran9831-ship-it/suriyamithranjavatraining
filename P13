import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int N;
        Scanner m = new Scanner(System.in);
        N= m.nextInt();
        if (N % 2 == 0) {
            System.out.println("Even");
        }
        else {
            System.out.println("Odd");
        }
    }
}
